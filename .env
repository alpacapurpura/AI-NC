# ==============================================
# CONFIGURACIÓN GLOBAL - TRAEFIK UNIFIED DEPLOY
# ==============================================

# Dominios configurados
FLOWISE_DOMAIN=flowise.alpacapurpura.lat
N8N_DOMAIN=n8n.alpacapurpura.lat
N8N_PROTOCOL=https

# Email para Let's Encrypt SSL
LETSENCRYPT_EMAIL=alpacapurpura@gmail.com

# ==============================================
# CONFIGURACIÓN DE FLOWISE
# ==============================================

# Credenciales de acceso a Flowise
FLOWISE_USERNAME=alpacapurpura@gmail.com
FLOWISE_PASSWORD=alpacapurpura123

# Clave secreta para Flowise (generar una clave segura)
FLOWISE_SECRET_KEY=mi_clave_secreta_flowise_2024_segura_alpaca_purpura_12345

# ==============================================
# CONFIGURACIÓN DE N8N
# ==============================================

# Configuración de PostgreSQL
POSTGRES_USER=n8n
POSTGRES_PASSWORD=n8n_secure_password_2024
POSTGRES_DB=n8n

# Claves de seguridad para n8n (generar claves largas y seguras)
N8N_ENCRYPTION_KEY=mi_clave_de_encriptacion_n8n_muy_larga_y_segura_2024_alpaca_purpura_123456789_abcdefghijklmnopqrstuvwxyz
N8N_USER_MANAGEMENT_JWT_SECRET=mi_jwt_secret_muy_largo_y_seguro_para_n8n_2024_alpaca_purpura_123456789_abcdefghijklmnopqrstuvwxyz

# Configuración de zona horaria
TZ=America/Lima

# ==============================================
# OPCIONES AVANZADAS (DESCOMENTAR SI ES NECESARIO)
# ==============================================

# Configuración de límites de recursos (opcional)
FLOWISE_MEMORY_LIMIT=4g
FLOWISE_CPU_LIMIT=2.0
N8N_MEMORY_LIMIT=4g
N8N_CPU_LIMIT=2.0
POSTGRES_MEMORY_LIMIT=2g
POSTGRES_CPU_LIMIT=2.0

# Configuración de backup (opcional)
# BACKUP_SCHEDULE=0 2 * * *
# BACKUP_RETENTION_DAYS=7

# Configuración de monitoreo (opcional)
# ENABLE_MONITORING=true
# GRAFANA_DOMAIN=grafana.alpacapurpura.lat
# PROMETHEUS_DOMAIN=prometheus.alpacapurpura.lat